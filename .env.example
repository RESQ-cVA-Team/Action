# Action environment template.
#
# Loaded automatically via python-dotenv -- copy to .env in the repo
# root. Real process env vars win over .env for the same key, so this
# is safe alongside docker-compose environment: blocks too. Never
# commit the real .env.

# --- LLM (plan generation, orchestrator decisions) -----------------------

LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
# Real secret -- pull from wherever your team keeps it, never hardcode here.
# Required for the openai provider. openai-compatible/vllm/sglang fall back
# to OPENAI_API_KEY if this is unset; ollama doesn't need either.
LLM_API_KEY=
# OPENAI_API_KEY=
# LLM_BASE_URL=
# LLM_KWARGS_JSON=

# --- Talking to Webapp (GraphQL/analytics data access) -------------------

# Despite the name, this points at Webapp, not Rasa -- Webapp holds the
# real per-user Keycloak token and proxies GraphQL requests on Action's
# behalf. Every request also carries a jobId (server-side identity mapping,
# never a caller-supplied sub) -- required, not optional: requests made
# with no jobId available (synchronous/rasa-shell execution) fail loudly
# rather than silently sending an unauthenticated-identity request.
# Already set by docker-compose.yml.

# RASA_PROXY_URL=http://host.docker.internal:3000/api/rasa-proxy
# Must match target names in Webapp's own RASA_PROXY_TARGETS config.
# RASA_PROXY_GRAPHQL_TARGET=graphql
# RASA_PROXY_ANALYTICS_TARGET=analytics

# Action's own service identity toward Webapp's/CVaLab's rasa-proxy and
# long-task-callback -- a real Keycloak client-credentials token, the only
# proof of identity those endpoints accept. Needs a dedicated Keycloak
# client with service accounts enabled (cannot reuse Webapp's own `cva`
# client, which uses the authorization-code flow for real users, not
# client_credentials). Required -- there is no static-secret fallback.
KEYCLOAK_ISSUER=
ACTION_SERVICE_CLIENT_ID=
ACTION_SERVICE_CLIENT_SECRET=

# --- Rasa calling into Action's own action-invocation endpoint -----------

# Shared secret Action's /webhook checks on every inbound action-invocation
# call -- same value as Rasa's ACTION_TOKEN (src/core/endpoints.*.yml's
# action_endpoint.token). Rasa_sdk has no built-in auth for this endpoint,
# so this is enforced by this repo's own Sanic middleware instead.
ACTION_TOKEN=
# Required by default -- set to false only for local debugging without Rasa
# in front (e.g. invoking actions directly).
ACTION_REQUIRE_AUTH_TOKEN=true

# --- Long-running visualization task callbacks ----------------------------

# Callbacks authenticate with the same Keycloak service-account identity
# configured above (KEYCLOAK_ISSUER/ACTION_SERVICE_CLIENT_ID/_SECRET) -- no
# separate secret needed here.
# Fallback only -- CVaLab/Webapp both supply their own callback_url.
# CALLBACK_BASE_URL=
# Origins/paths the callback receiver accepts a callback_url from --
# include wherever your Webapp/CVaLab devcontainers are reachable. Already
# set by docker-compose.yml.
# LONG_TASK_CALLBACK_ALLOWED_ORIGINS=http://host.docker.internal:3000,http://host.docker.internal:4010
# LONG_TASK_CALLBACK_ALLOWED_PATHS=

# --- Tuning (all have sane defaults, rarely need changing) ---------------

# ACTIONS_LLM_PLANNER_REQUEST_TIMEOUT_SECONDS=
