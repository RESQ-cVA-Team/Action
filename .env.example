# ACTION_VERSION=
# ACTION_COMMIT_SHA=
# ACTION_IMAGE_TAG=
# ACTION_BUILD_DATE=
# ACTION_SSOT_VERSION=
# ACTION_PROMPT_VERSION=

# Dev convenience: .env values override already-set process env vars
# instead of losing to them. Leave false unless troubleshooting.
# ACTION_DOTENV_OVERRIDE=false
